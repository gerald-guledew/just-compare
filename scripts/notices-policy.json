{
  "schemaVersion": 1,
  "targets": [
    "aarch64-apple-darwin",
    "x86_64-apple-darwin",
    "x86_64-pc-windows-msvc",
    "x86_64-unknown-linux-gnu"
  ],
  "cargoFeatures": ["tauri/custom-protocol"],
  "frontendRuntimeRoots": [
    "@monaco-editor/react",
    "@tanstack/react-virtual",
    "@tauri-apps/api",
    "@tauri-apps/plugin-dialog",
    "@tauri-apps/plugin-store",
    "monaco-editor",
    "react",
    "react-dom",
    "zustand"
  ],
  "frontendBuildOnlyRoots": ["@tailwindcss/vite", "tailwindcss"],
  "licensePreference": [
    "MIT",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "Apache-2.0",
    "Apache-2.0 WITH LLVM-exception",
    "Unicode-3.0",
    "0BSD",
    "MIT-0",
    "CC0-1.0",
    "Unlicense",
    "Zlib",
    "MPL-2.0"
  ],
  "licenseSelections": {
    "npm:dompurify@3.4.16": "Apache-2.0"
  },
  "legacyLicenseExpressions": {
    "Apache-2.0 / MIT": "Apache-2.0 OR MIT",
    "Apache-2.0/MIT": "Apache-2.0 OR MIT",
    "BSD-3-Clause/MIT": "BSD-3-Clause AND MIT",
    "MIT / Apache-2.0": "MIT OR Apache-2.0",
    "MIT/Apache-2.0": "MIT OR Apache-2.0",
    "Unlicense/MIT": "Unlicense OR MIT"
  }
}
